{
    "default" : {
        "formatOptions" : {
            "snippetInterface" : "async-await"
        },
        "paths" : [
            "src/test/features/*"
        ],
        "publishQuiet" : true,
        "dryRun" : false,
        "require" : [
            "src/test/steps/*.ts",
            "src/hooks/hooks.ts"
        ],
        "requireModule" : [
            "ts-node/register"
        ],
        "format": [
            "progress-bar",
            "html:cucumber-report.html",
            "json:cucumber-report.json",
            "json:test-result/cucumber-report.json",
            "rerun:@rerun.txt"
        ],
        "parallel" : 1,
        
        "timeout": 30000

    },
    "rerun" : {
        "formatOptions" : {
            "snippetInterface" : "async-await"
        },
        "publishQuiet" : true,
        "dryRun" : true,
        "require" : [
            "src/test/steps/*.ts",
            "src/hooks/hooks.ts"
        ],
        "requireModule" : [
            "ts-node/register"
        ],
        "format": [
            "progress-bar",
            "html:cucumber-report.html",
            "json:cucumber-report.json",
            "json:test-result/cucumber-report.json",
            "rerun:@rerun.txt"
        ],
        "timeout": 30000

    }
}